<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/ventlog_widget_bg"
    android:contentDescription="Ventlog: tap to start a voice rant">
    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ventlog_widget_mic"
        android:contentDescription="Microphone" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ventlog."
            android:textColor="#A1EEC9"
            android:textStyle="bold"
            android:textSize="13sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rant now"
            android:textColor="#F2F6FE"
            android:textStyle="bold"
            android:textSize="17sp"
            android:maxLines="1" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_type"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="49dp"
        android:gravity="center"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:background="@drawable/ventlog_widget_type_bg"
        android:contentDescription="Type a rant"
        android:text="TYPE"
        android:textStyle="bold"
        android:textSize="11sp"
        android:textColor="#ACEDD1" />
</LinearLayout>
